/*
 * Phoenix-RTOS
 *
 * Operating system loader
 *
 * Cortex-A72 low-memory placement.
 *
 * The old generic A53 placement put PLO at 0x40080000. That is above usable
 * ARM RAM on the real 1 GB Raspberry Pi 4B bring-up board, so Pi 4 must not
 * reuse that layout.
 *
 * Copyright 2026 Phoenix Systems
 *
 * This file is part of Phoenix-RTOS.
 *
 * %LICENSE%
 */

#ifndef AARCH64A72_GENERIC_LDT
#define AARCH64A72_GENERIC_LDT

#define SIZE_PAGE  0x1000
#define SIZE_STACK (4 * SIZE_PAGE)
#define SIZE_HEAP  (4 * SIZE_PAGE)

/* Pi 4 4GB layout (with config.txt gpu_mem=76):
 *   0x00000000 - 0x3b3fffff   948 MB   ARM DRAM (chunk 1)
 *   0x3b400000 - 0x3fffffff    76 MB   GPU heap + framebuffer (VC4 owns, ARM Device)
 *   0x40000000 - 0xfbffffff  3008 MB   ARM DRAM (chunk 2)
 *   0xfc000000 - 0xffffffff    64 MB   BCM2711 peripherals (low-peri mode)
 *
 * SIZE_DDR is the high-water-mark for the cacheable remap (everything from
 * ADDR_DDR up to but excluding the BCM2711 peripheral aperture). The 76 MB
 * GPU hole in the middle is carved out at runtime by hal_memoryInit so VC4
 * framebuffer/heap pages stay Device-nGnRE and don't get cache-aliased.
 * total_mem= cannot enlarge memory, only cap it — we don't use it.
 */
#define ADDR_DDR 0x00000000
#define SIZE_DDR 0xfc000000

#define ADDR_GPU_RSV 0x3b400000
#define SIZE_GPU_RSV 0x04c00000

#define ADDR_PLO 0x00200000
#define SIZE_PLO 0x00200000

#if defined(__LINKER__)

MEMORY
{
	m_ram (rwx) : ORIGIN = ADDR_PLO, LENGTH = SIZE_PLO
}

REGION_ALIAS("PLO_IMAGE", m_ram);
REGION_ALIAS("TCM_TEXT", m_ram);
REGION_ALIAS("DATA", m_ram);
REGION_ALIAS("BSS", m_ram);
REGION_ALIAS("HEAP", m_ram);
REGION_ALIAS("STACK", m_ram);

#include "common/plo-aarch64.lds"

#endif

#endif
